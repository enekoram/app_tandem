{
  "openapi": "3.0.0",
  "paths": {
    "/me": {
      "get": {
        "operationId": "MeController_me",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeDto"
                }
              }
            }
          },
          "401": {
            "description": "Sin sesión"
          }
        },
        "security": [
          {
            "cookie": []
          }
        ],
        "tags": [
          "me"
        ]
      }
    },
    "/health": {
      "get": {
        "operationId": "HealthController_check",
        "parameters": [],
        "responses": {
          "200": {
            "description": "La API y MongoDB responden\n\nThe Health Check is successful",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/TerminusHealthCheckResult"
                    }
                  ],
                  "properties": {
                    "status": {
                      "enum": [
                        "ok",
                        "degraded"
                      ],
                      "example": "ok"
                    },
                    "error": {
                      "example": {}
                    },
                    "details": {
                      "example": {
                        "database": {
                          "status": "up",
                          "responseTime": 12
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "MongoDB no responde\n\nThe Health Check is not successful",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/TerminusHealthCheckResult"
                    }
                  ],
                  "properties": {
                    "status": {
                      "enum": [
                        "error",
                        "shutting_down"
                      ],
                      "example": "error"
                    },
                    "error": {
                      "example": {
                        "redis": {
                          "status": "down",
                          "message": "Could not connect",
                          "responseTime": 3005
                        }
                      }
                    },
                    "details": {
                      "example": {
                        "database": {
                          "status": "up",
                          "responseTime": 12
                        },
                        "redis": {
                          "status": "down",
                          "message": "Could not connect",
                          "responseTime": 3005
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "tags": [
          "health"
        ]
      }
    },
    "/contacts": {
      "get": {
        "operationId": "ContactsController_list",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ContactDto"
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "cookie": []
          }
        ],
        "tags": [
          "contacts"
        ]
      },
      "post": {
        "operationId": "ContactsController_invite",
        "parameters": [
          {
            "name": "host",
            "required": true,
            "in": "header",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "x-app-link",
            "required": true,
            "in": "header",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 40
                  },
                  "email": {
                    "type": "string"
                  }
                },
                "required": [
                  "name",
                  "email"
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InviteResultDto"
                }
              }
            }
          },
          "409": {
            "description": "CONTACT_EXISTS: ya está en tus contactos"
          }
        },
        "security": [
          {
            "cookie": []
          }
        ],
        "tags": [
          "contacts"
        ]
      }
    },
    "/contacts/{id}": {
      "get": {
        "operationId": "ContactsController_get",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContactDto"
                }
              }
            }
          },
          "404": {
            "description": ""
          }
        },
        "security": [
          {
            "cookie": []
          }
        ],
        "tags": [
          "contacts"
        ]
      },
      "delete": {
        "operationId": "ContactsController_remove",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": ""
          }
        },
        "security": [
          {
            "cookie": []
          }
        ],
        "tags": [
          "contacts"
        ]
      }
    },
    "/contacts/{id}/resend": {
      "post": {
        "operationId": "ContactsController_resend",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "host",
            "required": true,
            "in": "header",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "x-app-link",
            "required": true,
            "in": "header",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResendResultDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "cookie": []
          }
        ],
        "tags": [
          "contacts"
        ]
      }
    },
    "/invitations/{token}": {
      "get": {
        "operationId": "InvitationsController_preview",
        "parameters": [
          {
            "name": "token",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InvitationPreviewDto"
                }
              }
            }
          },
          "404": {
            "description": "INVITATION_NOT_FOUND"
          },
          "410": {
            "description": "INVITATION_EXPIRED · INVITATION_USED"
          }
        },
        "tags": [
          "invitations"
        ]
      }
    },
    "/invitations/{token}/accept": {
      "post": {
        "operationId": "InvitationsController_accept",
        "parameters": [
          {
            "name": "token",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "El contacto de quien te invitó, ya aceptado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContactDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "cookie": []
          }
        ],
        "tags": [
          "invitations"
        ]
      }
    }
  },
  "info": {
    "title": "Tandems API",
    "description": "API de Tandems",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "MeDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "665f1c2e8b3a4d0012345678"
          },
          "displayName": {
            "type": "string",
            "example": "Marta",
            "maxLength": 40
          },
          "email": {
            "type": "string",
            "example": "marta@example.com"
          },
          "timezone": {
            "type": "string",
            "example": "Europe/Madrid"
          },
          "stimulus": {
            "type": "string",
            "enum": [
              "full",
              "soft",
              "minimal"
            ]
          }
        },
        "required": [
          "id",
          "displayName",
          "email",
          "timezone",
          "stimulus"
        ]
      },
      "TerminusHealthIndicatorResult": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "up",
              "degraded",
              "down"
            ],
            "description": "The status of this health indicator"
          },
          "responseTime": {
            "type": "number",
            "description": "Time the health indicator took to respond, in ms"
          },
          "cachedResponse": {
            "type": "boolean",
            "description": "Whether this result was served from the cache"
          }
        },
        "required": [
          "status"
        ]
      },
      "TerminusHealthCheckResult": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "error",
              "ok",
              "degraded",
              "shutting_down"
            ],
            "example": "ok"
          },
          "info": {
            "type": "object",
            "additionalProperties": {
              "allOf": [
                {
                  "$ref": "#/components/schemas/TerminusHealthIndicatorResult"
                },
                {
                  "type": "object",
                  "additionalProperties": true
                }
              ]
            },
            "example": {
              "database": {
                "status": "up",
                "responseTime": 12
              }
            },
            "nullable": true
          },
          "error": {
            "type": "object",
            "additionalProperties": {
              "allOf": [
                {
                  "$ref": "#/components/schemas/TerminusHealthIndicatorResult"
                },
                {
                  "type": "object",
                  "additionalProperties": true
                }
              ]
            },
            "example": {},
            "nullable": true
          },
          "details": {
            "type": "object",
            "additionalProperties": {
              "allOf": [
                {
                  "$ref": "#/components/schemas/TerminusHealthIndicatorResult"
                },
                {
                  "type": "object",
                  "additionalProperties": true
                }
              ]
            },
            "example": {
              "database": {
                "status": "up",
                "responseTime": 12
              }
            }
          }
        },
        "required": [
          "status",
          "details"
        ]
      },
      "ContactDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "665f1c2e8b3a4d0012345678"
          },
          "name": {
            "type": "string",
            "example": "Lucía"
          },
          "email": {
            "type": "string",
            "example": "lucia@email.com"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "accepted"
            ]
          },
          "color": {
            "type": "string",
            "enum": [
              "lilac",
              "slate",
              "rose",
              "sun",
              "sage",
              "ochre",
              "periwinkle",
              "sea"
            ],
            "description": "Color de persona (usePersonStyle)"
          },
          "initials": {
            "type": "string",
            "example": "L",
            "description": "1–2 letras o un emoji"
          },
          "userId": {
            "type": "string",
            "nullable": true,
            "description": "Solo si ya tiene cuenta"
          },
          "createdAt": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "email",
          "status",
          "color",
          "initials",
          "createdAt"
        ]
      },
      "InviteResultDto": {
        "type": "object",
        "properties": {
          "contact": {
            "$ref": "#/components/schemas/ContactDto"
          },
          "inviteUrl": {
            "type": "string",
            "description": "Enlace para la hoja de compartir (WhatsApp, Telegram…)"
          }
        },
        "required": [
          "contact",
          "inviteUrl"
        ]
      },
      "ResendResultDto": {
        "type": "object",
        "properties": {
          "inviteUrl": {
            "type": "string"
          }
        },
        "required": [
          "inviteUrl"
        ]
      },
      "InvitationPreviewDto": {
        "type": "object",
        "properties": {
          "inviterName": {
            "type": "string",
            "example": "Marta"
          }
        },
        "required": [
          "inviterName"
        ]
      }
    }
  }
}
