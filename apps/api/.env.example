# Copia este archivo a .env (no se sube al repositorio) y rellena los valores.
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
# Cadena de conexión de Atlas (base de datos tandems_dev). Ejemplo de forma:
# mongodb+srv://USUARIO:CONTRASEÑA@CLUSTER.mongodb.net/tandems_dev?retryWrites=true&w=majority
MONGODB_URI=
