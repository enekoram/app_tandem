# Copia este archivo a .env (no se sube al repositorio) y rellena los valores.
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
# Cadena de conexión de Atlas (base de datos tandems_dev). Ejemplo de forma:
# mongodb+srv://USUARIO:CONTRASEÑA@CLUSTER.mongodb.net/tandems_dev?retryWrites=true&w=majority
MONGODB_URI=

# Firma de sesiones de Better Auth. Genera uno con: openssl rand -base64 48
BETTER_AUTH_SECRET=
# URL pública de la API (enlaces de los emails). En desarrollo, pnpm dev pone la IP del Mac.
BETTER_AUTH_URL=http://localhost:3000
# Resend (clave de envío). Sin ella los emails no se envían.
RESEND_API_KEY=
EMAIL_FROM=Tandems <avisos@tandems.minucampoy.com>
